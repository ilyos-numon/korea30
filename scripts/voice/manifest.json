    },
    {
      "lang": "en",
      "key": "5d0b5e8c",
      "file": "en/5d0b5e8c.mp3",
      "text": "National pension"
    },
    {
      "lang": "en",
      "key": "a4c901f9",
      "file": "en/a4c901f9.mp3",
      "text": "Night work pay"
    },
    {
      "lang": "en",
      "key": "a379e207",
      "file": "en/a379e207.mp3",
      "text": "Non-taxable"
    },
    {
      "lang": "en",
      "key": "883caaf2",
      "file": "en/883caaf2.mp3",
      "text": "One 20-liter official trash bag, please."
    },
    {
      "lang": "en",
      "key": "2a94183e",
      "file": "en/2a94183e.mp3",
      "text": "One bag, please. I will pay by card."
    },
    {
      "lang": "en",
      "key": "d9288ac9",
      "file": "en/d9288ac9.mp3",
      "text": "One transit card, please. Please top it up with 10,000 won."
    },
    {
      "lang": "en",
      "key": "df3a2dc6",
      "file": "en/df3a2dc6.mp3",
      "text": "Ordinary wage"
    },
    {
      "lang": "en",
      "key": "02908d7d",
      "file": "en/02908d7d.mp3",
      "text": "Overtime pay"
    },
    {
      "lang": "en",
      "key": "58c74a28",
      "file": "en/58c74a28.mp3",
      "text": "Payslip"
    },
    {
      "lang": "en",
      "key": "fcec898d",
      "file": "en/fcec898d.mp3",
      "text": "Place of stay"
    },
    {
      "lang": "en",
      "key": "2cbab30a",
      "file": "en/2cbab30a.mp3",
      "text": "Please say it one more time."
    },
    {
      "lang": "en",
      "key": "d8a0e7b2",
      "file": "en/d8a0e7b2.mp3",
      "text": "Please write it here."
    },
    {
      "lang": "en",
      "key": "44f81c4f",
      "file": "en/44f81c4f.mp3",
      "text": "Proof of employment"
    },
    {
      "lang": "en",
      "key": "802d2f78",
      "file": "en/802d2f78.mp3",
      "text": "Severance pay"
    },
    {
      "lang": "en",
      "key": "f0e02e83",
      "file": "en/f0e02e83.mp3",
      "text": "Someone is hurt. Please come quickly."
    },
    {
      "lang": "en",
      "key": "5a092150",
      "file": "en/5a092150.mp3",
      "text": "Status of stay"
    },
    {
      "lang": "en",
      "key": "f659d097",
      "file": "en/f659d097.mp3",
      "text": "Take-home pay"
    },
    {
      "lang": "en",
      "key": "b1aecaed",
      "file": "en/b1aecaed.mp3",
      "text": "Taxable"
    },
    {
      "lang": "en",
      "key": "705ca720",
      "file": "en/705ca720.mp3",
      "text": "Thank you for this month. I look forward to working with you."
    },
    {
      "lang": "en",
      "key": "0bc26f8c",
      "file": "en/0bc26f8c.mp3",
      "text": "Thank you for your help."
    },
    {
      "lang": "en",
      "key": "12bdd814",
      "file": "en/12bdd814.mp3",
      "text": "This is my first visit. I want to see a doctor."
    },
    {
      "lang": "en",
      "key": "4a265ea8",
      "file": "en/4a265ea8.mp3",
      "text": "Total pay"
    },
    {
      "lang": "en",
      "key": "9ace8982",
      "file": "en/9ace8982.mp3",
      "text": "Until what time do I work today?"
    },
    {
      "lang": "en",
      "key": "e08646b8",
      "file": "en/e08646b8.mp3",
      "text": "Weekly paid day off"
    },
    {
      "lang": "en",
      "key": "e834a57c",
      "file": "en/e834a57c.mp3",
      "text": "What do I write in this box?"
    },
    {
      "lang": "en",
      "key": "8a1a3917",
      "file": "en/8a1a3917.mp3",
      "text": "What else do I need to bring?"
    },
    {
      "lang": "en",
      "key": "73278802",
      "file": "en/73278802.mp3",
      "text": "When can I use the washing machine?"
    },
    {
      "lang": "en",
      "key": "c69890c4",
      "file": "en/c69890c4.mp3",
      "text": "When should I come back?"
    },
    {
      "lang": "en",
      "key": "2e23becc",
      "file": "en/2e23becc.mp3",
      "text": "Where do I hand in this paper?"
    },
    {
      "lang": "en",
      "key": "1021e04f",
      "file": "en/1021e04f.mp3",
      "text": "Where do I write my start time and finish time?"
    },
    {
      "lang": "en",
      "key": "4ff4f3c4",
      "file": "en/4ff4f3c4.mp3",
      "text": "Where is the restroom?"
    },
    {
      "lang": "en",
      "key": "6128b47f",
      "file": "en/6128b47f.mp3",
      "text": "Year-end tax settlement"
    },
    {
      "lang": "ru",
      "key": "3fd3e9d9",
      "file": "ru/3fd3e9d9.mp3",
      "text": "4 вида соцстрахования"
    },
    {
      "lang": "ru",
      "key": "bd72ebd9",
      "file": "ru/bd72ebd9.mp3",
      "text": "HiKorea (миграционный сайт)"
    },
    {
      "lang": "ru",
      "key": "f2d5dee5",
      "file": "ru/f2d5dee5.mp3",
      "text": "Базовый оклад"
    },
    {
      "lang": "ru",
      "key": "a99257ff",
      "file": "ru/a99257ff.mp3",
      "text": "Банковская книжка (счёт)"
    },
    {
      "lang": "ru",
      "key": "d4b64c36",
      "file": "ru/d4b64c36.mp3",
      "text": "Выходное пособие"
    },
    {
      "lang": "ru",
      "key": "b1d2f032",
      "file": "ru/b1d2f032.mp3",
      "text": "Где записывать время прихода и время ухода с работы?"
    },
    {
      "lang": "ru",
      "key": "87634452",
      "file": "ru/87634452.mp3",
      "text": "Где туалет?"
    },
    {
      "lang": "ru",
      "key": "d3146a83",
      "file": "ru/d3146a83.mp3",
      "text": "Годовой перерасчёт налога"
    },
    {
      "lang": "ru",
      "key": "65303b23",
      "file": "ru/65303b23.mp3",
      "text": "Государственная пенсия"
    },
    {
      "lang": "ru",
      "key": "f47f404b",
      "file": "ru/f47f404b.mp3",
      "text": "Дайте, пожалуйста, один пакет. Я заплачу картой."
    },
    {
      "lang": "ru",
      "key": "31abb061",
      "file": "ru/31abb061.mp3",
      "text": "Дайте, пожалуйста, одну транспортную карту. Пополните её на 10 000 вон."
    },
    {
      "lang": "ru",
      "key": "90cea407",
      "file": "ru/90cea407.mp3",
      "text": "Дайте, пожалуйста, платный мешок для мусора на 20 литров."
    },
    {
      "lang": "ru",
      "key": "9c15fbce",
      "file": "ru/9c15fbce.mp3",
      "text": "Дебетовая карта"
    },
    {
      "lang": "ru",
      "key": "b598cf83",
      "file": "ru/b598cf83.mp3",
      "text": "Деньги на питание"
    },
    {
      "lang": "ru",
      "key": "8b37c950",
      "file": "ru/8b37c950.mp3",
      "text": "До скольки я сегодня работаю?"
    },
    {
      "lang": "ru",
      "key": "9106e06d",
      "file": "ru/9106e06d.mp3",
      "text": "Доплата за ночную работу"
    },
    {
      "lang": "ru",
      "key": "c96b0397",
      "file": "ru/c96b0397.mp3",
      "text": "Доплата за работу в выходной"
    },
    {
      "lang": "ru",
      "key": "c219eeec",
      "file": "ru/c219eeec.mp3",
      "text": "Доплата за сверхурочную работу"
    },
    {
      "lang": "ru",
      "key": "da30bb02",
      "file": "ru/da30bb02.mp3",
      "text": "Карта регистрации иностранца"
    },
    {
      "lang": "ru",
      "key": "7d67605c",
      "file": "ru/7d67605c.mp3",
      "text": "Когда мне прийти снова?"
    },
    {
      "lang": "ru",
      "key": "ddaf2f0c",
      "file": "ru/ddaf2f0c.mp3",
      "text": "Когда можно пользоваться стиральной машиной?"
    },
    {
      "lang": "ru",
      "key": "301f10b5",
      "file": "ru/301f10b5.mp3",
      "text": "Компания сама делает годовой перерасчёт налога?"
    },
    {
      "lang": "ru",
      "key": "f68631bf",
      "file": "ru/f68631bf.mp3",
      "text": "Куда сдавать этот документ?"
    },
    {
      "lang": "ru",
      "key": "420e4e72",
      "file": "ru/420e4e72.mp3",
      "text": "Медицинское страхование"
    },
    {
      "lang": "ru",
      "key": "6275bd01",
      "file": "ru/6275bd01.mp3",
      "text": "Местный подоходный налог"
    },
    {
      "lang": "ru",
      "key": "66ef6a0e",
      "file": "ru/66ef6a0e.mp3",
      "text": "Место пребывания"
    },
    {
      "lang": "ru",
      "key": "39dc8efe",
      "file": "ru/39dc8efe.mp3",
      "text": "Миграционная служба"
    },
    {
      "lang": "ru",
      "key": "6e79ff95",
      "file": "ru/6e79ff95.mp3",
      "text": "Минимальная зарплата"
    },
    {
      "lang": "ru",
      "key": "56c1e90c",
      "file": "ru/56c1e90c.mp3",
      "text": "Можете соединить меня с переводчиком?"
    },
    {
      "lang": "ru",
      "key": "a9659d56",
      "file": "ru/a9659d56.mp3",
      "text": "Можно ли переводчика с русским языком?"
    },
    {
      "lang": "ru",
      "key": "027a5e55",
      "file": "ru/027a5e55.mp3",
      "text": "Можно оформить дебетовую карту к этому счёту?"
    },
    {
      "lang": "ru",
      "key": "ee994dca",
      "file": "ru/ee994dca.mp3",
      "text": "Можно получить одну копию трудового договора?"
    },
    {
      "lang": "ru",
      "key": "30d89a69",
      "file": "ru/30d89a69.mp3",
      "text": "Можно получить расчётный листок за этот месяц?"
    },
    {
      "lang": "ru",
      "key": "9a02560b",
      "file": "ru/9a02560b.mp3",
      "text": "Напишите, пожалуйста, здесь."
    },
    {
      "lang": "ru",
      "key": "fc42b069",
      "file": "ru/fc42b069.mp3",
      "text": "Начислено всего"
    },
    {
      "lang": "ru",
      "key": "9312e75d",
      "file": "ru/9312e75d.mp3",
      "text": "Не облагается налогом"
    },
    {
      "lang": "ru",
      "key": "1b975843",
      "file": "ru/1b975843.mp3",
      "text": "Облагается налогом"
    },
    {
      "lang": "ru",
      "key": "9b0b52c4",
      "file": "ru/9b0b52c4.mp3",
      "text": "Обычная зарплата"
    },
    {
      "lang": "ru",
      "key": "dbcd5320",
      "file": "ru/dbcd5320.mp3",
      "text": "Оплата еженедельного выходного"
    },
    {
      "lang": "ru",
      "key": "1f3735b5",
      "file": "ru/1f3735b5.mp3",
      "text": "Повторите, пожалуйста, ещё раз."
    },
    {
      "lang": "ru",
      "key": "21e2bed8",
      "file": "ru/21e2bed8.mp3",
      "text": "Подоходный налог"
    },
    {
      "lang": "ru",
      "key": "7d5fb89d",
      "file": "ru/7d5fb89d.mp3",
      "text": "Премия"
    },
    {
      "lang": "ru",
      "key": "ef026444",
      "file": "ru/ef026444.mp3",
      "text": "Продление срока пребывания"
    },
    {
      "lang": "ru",
      "key": "d602c949",
      "file": "ru/d602c949.mp3",
      "text": "Расписка о приёме документов"
    },
    {
      "lang": "ru",
      "key": "d587f814",
      "file": "ru/d587f814.mp3",
      "text": "Расчётный листок"
    },
    {
      "lang": "ru",
      "key": "6cd22a4e",
      "file": "ru/6cd22a4e.mp3",
      "text": "Регистрационный номер иностранца"
    },
    {
      "lang": "ru",
      "key": "311f9129",
      "file": "ru/311f9129.mp3",
      "text": "Регистрационный номер компании"
    },
    {
      "lang": "ru",
      "key": "fc912dc1",
      "file": "ru/fc912dc1.mp3",
      "text": "Регистрация иностранца"
    },
    {
      "lang": "ru",
      "key": "c6822d95",
      "file": "ru/c6822d95.mp3",
      "text": "Сколько это стоит?"
    },
    {
      "lang": "ru",
      "key": "271350e1",
      "file": "ru/271350e1.mp3",
      "text": "Смена места работы"
    },
    {
      "lang": "ru",
      "key": "2ecdc3ff",
      "file": "ru/2ecdc3ff.mp3",
      "text": "Спасибо за помощь."
    },
    {
      "lang": "ru",
      "key": "e6c929f8",
      "file": "ru/e6c929f8.mp3",
      "text": "Спасибо за этот месяц. Надеюсь на вашу помощь и дальше."
    },
    {
      "lang": "ru",
      "key": "5b81409f",
      "file": "ru/5b81409f.mp3",
      "text": "Справка с места работы"
    },
    {
      "lang": "ru",
      "key": "1680296f",
      "file": "ru/1680296f.mp3",
      "text": "Статус пребывания"
    },
    {
      "lang": "ru",
      "key": "95170f70",
      "file": "ru/95170f70.mp3",
      "text": "Страхование долгосрочного ухода"
    },
    {
      "lang": "ru",
      "key": "77e35128",
      "file": "ru/77e35128.mp3",
      "text": "Страхование от несчастных случаев на работе"
    },
    {
      "lang": "ru",
      "key": "4eeaf4a2",
      "file": "ru/4eeaf4a2.mp3",
      "text": "Страхование по безработице"
    },
    {
      "lang": "ru",
      "key": "b0653c2e",
      "file": "ru/b0653c2e.mp3",
      "text": "Сумма на руки"
    },
    {
      "lang": "ru",
      "key": "b4db8c0f",
      "file": "ru/b4db8c0f.mp3",
      "text": "Трудовой договор"
    },
    {
      "lang": "ru",
      "key": "fbe65311",
      "file": "ru/fbe65311.mp3",
      "text": "У меня болит вот здесь."
    },
    {
      "lang": "ru",
      "key": "7d0b5926",
      "file": "ru/7d0b5926.mp3",
      "text": "Удержание"
    },
    {
      "lang": "ru",
      "key": "f855c9dc",
      "file": "ru/f855c9dc.mp3",
      "text": "Человек ранен. Пожалуйста, приезжайте быстрее."
    },
    {
      "lang": "ru",
      "key": "fe675580",
      "file": "ru/fe675580.mp3",
      "text": "Что ещё мне нужно принести?"
    },
    {
      "lang": "ru",
      "key": "42454674",
      "file": "ru/42454674.mp3",
      "text": "Что нужно написать в этой графе?"
    },
    {
      "lang": "ru",
      "key": "02b41070",
      "file": "ru/02b41070.mp3",
      "text": "Я здесь впервые. Я хочу попасть на приём к врачу."
    },
    {
      "lang": "ru",
      "key": "aafaf8a8",
      "file": "ru/aafaf8a8.mp3",
      "text": "Я переехал (переехала). Я пришёл (пришла) сообщить о смене адреса."
    },
    {
      "lang": "ru",
      "key": "6aa5a7c6",
      "file": "ru/6aa5a7c6.mp3",
      "text": "Я плохо говорю по-корейски. Говорите, пожалуйста, медленнее."
    },
    {
      "lang": "ru",
      "key": "83777fdc",
      "file": "ru/83777fdc.mp3",
      "text": "Я плохо себя чувствую, сегодня мне нужно в больницу."
    },
    {
      "lang": "ru",
      "key": "42b4644e",
      "file": "ru/42b4644e.mp3",
      "text": "Я получил (получила) травму на работе. Я хочу в больницу."
    },
    {
      "lang": "ru",
      "key": "14711341",
      "file": "ru/14711341.mp3",
      "text": "Я потерял (потеряла) карту регистрации иностранца. Что мне делать?"
    },
    {
      "lang": "ru",
      "key": "2178a7cf",
      "file": "ru/2178a7cf.mp3",
      "text": "Я пришёл (пришла) за картой регистрации иностранца."
    },
    {
      "lang": "ru",
      "key": "f87406d6",
      "file": "ru/f87406d6.mp3",
      "text": "Я пришёл (пришла) на регистрацию иностранца."
    },
    {
      "lang": "ru",
      "key": "11b2ef8b",
      "file": "ru/11b2ef8b.mp3",
      "text": "Я хочу записаться на приём в миграционную службу."
    },
    {
      "lang": "ru",
      "key": "ffffd809",
      "file": "ru/ffffd809.mp3",
      "text": "Я хочу открыть счёт для получения зарплаты."
    },
    {
      "lang": "ru",
      "key": "6020a1fa",
      "file": "ru/6020a1fa.mp3",
      "text": "Я хочу отправить деньги на родину. Какая комиссия?"
    },
    {
      "lang": "ru",
      "key": "f6e4323c",
      "file": "ru/f6e4323c.mp3",
      "text": "Я хочу отправить международную посылку. Сколько она будет идти?"
    },
    {
      "lang": "ru",
      "key": "4995bcb9",
      "file": "ru/4995bcb9.mp3",
      "text": "Я хочу подключить предоплаченную SIM-карту. Вот мой паспорт."
    },
    {
      "lang": "ru",
      "key": "2958e4bb",
      "file": "ru/2958e4bb.mp3",
      "text": "Я хочу проверить, оформлен ли я в национальной пенсионной системе."
    },
    {
      "lang": "ru",
      "key": "c2680fb4",
      "file": "ru/c2680fb4.mp3",
      "text": "Я хочу проверить, оформлено ли у меня медицинское страхование."
    },
    {
      "lang": "ru",
      "key": "c81c7607",
      "file": "ru/c81c7607.mp3",
      "text": "Я хочу сменить тариф по карте регистрации иностранца."
    },
    {
      "lang": "ru",
      "key": "37540eb3",
      "file": "ru/37540eb3.mp3",
      "text": "Я хочу узнать, до какого числа мой срок пребывания."
    },
    {
      "lang": "ru",
      "key": "7359b3a5",
      "file": "ru/7359b3a5.mp3",
      "text": "Я хочу ходить на курсы корейского. Это бесплатно?"
    }
  ]
}
