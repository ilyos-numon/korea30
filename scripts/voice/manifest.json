    {
      "lang": "en",
      "key": "13d9ff9f",
      "file": "en/13d9ff9f.mp3",
      "text": "I came to do my foreigner registration."
    },
    {
      "lang": "en",
      "key": "b6162170",
      "file": "en/b6162170.mp3",
      "text": "I came to pick up my foreigner registration card."
    },
    {
      "lang": "en",
      "key": "0d962325",
      "file": "en/0d962325.mp3",
      "text": "I do not speak Korean well. Please speak slowly."
    },
    {
      "lang": "en",
      "key": "94e3b1d6",
      "file": "en/94e3b1d6.mp3",
      "text": "I got hurt while working. I want to go to the hospital."
    },
    {
      "lang": "en",
      "key": "2c2d92f9",
      "file": "en/2c2d92f9.mp3",
      "text": "I lost my foreigner registration card. What should I do?"
    },
    {
      "lang": "en",
      "key": "8c23bcd6",
      "file": "en/8c23bcd6.mp3",
      "text": "I moved. I came to report my new address."
    },
    {
      "lang": "en",
      "key": "50456911",
      "file": "en/50456911.mp3",
      "text": "I want to book a visit to the immigration office."
    },
    {
      "lang": "en",
      "key": "12705d11",
      "file": "en/12705d11.mp3",
      "text": "I want to change my phone plan with my foreigner registration card."
    },
    {
      "lang": "en",
      "key": "29ac7e10",
      "file": "en/29ac7e10.mp3",
      "text": "I want to check if I am signed up for health insurance."
